  "motion": {
    "principles": [
      "Snappy transitions (0.2s ease-out)",
      "Spring physics for gestures",
      "Staggered list entrances"
    ],
    "libraries": ["framer-motion"]
  },
  "instructions_to_main_agent": [
    "1. SETUP: Install 'lucide-react' and 'framer-motion' immediately.",
    "2. FONTS: Add 'Outfit' and 'DM Sans' from Google Fonts in index.html or CSS.",
    "3. LAYOUT: This is a MOBILE-FIRST app. Wrap the main content in a max-w-md container centered on screen for desktop users to simulate a mobile view.",
    "4. NAVIGATION: Create a floating bottom navigation bar (Glassmorphism style) with icons for Map, Chat, Camera, Stories, Profile.",
    "5. CAMERA: The 'Camera' page should be the default home. Use a full-screen video element (mocked with a gray placeholder or webcam feed if possible) with overlay controls.",
    "6. STORIES: Implement a horizontal scroll of circular avatars with a gradient ring (Cyber Lemon + Hot Pink) to indicate new stories.",
    "7. CHAT: Use the 'Swipeable' aesthetic. Clean rows, bold names, time stamps on the right.",
    "8. THEME: Default to LIGHT mode with bright yellow accents. Do not make it dark mode by default unless user toggles.",
    "9. DATA-TESTID: Add data-testid to all interactive elements (buttons, inputs, story circles)."
  ],
  "universal_guidelines": [
    "Avoid generic 'Inter' font. Use Outfit for headings.",
    "Do not use gradients for text, only for backgrounds/borders.",
    "Use 2-3x more spacing than typical designs.",
    "Every interaction needs micro-animations.",
    "Use 'sonner' for toasts."
  ]
}