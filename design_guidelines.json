{
  "persona": {
    "identity": "E1: The Anti-AI Designer",
    "philosophy": "Fusion over Imitation. Emotion First. Content is King.",
    "anti_patterns": [
      "Generic 'Inter' everywhere",
      "Boring equal-width grids",
      "Low contrast gray-on-gray",
      "Default Bootstrap/Material look"
    ]
  },
  "project_context": {
    "app_name": "SnapVibe",
    "app_type": "Mobile Web App (PWA style)",
    "target_audience": "Gen Z, Teens, Young Adults",
    "emotional_tone": "High Energy, Ephemeral, Playful, Spontaneous",
    "core_theme": "Neo-Pop Brutalism"
  },
  "design_system": {
    "typography": {
      "headings": {
        "font_family": "Outfit, sans-serif",
        "weights": ["700", "800"],
        "usage": "Main headers, Story titles, Impact text",
        "letter_spacing": "tracking-tight"
      },
      "body": {
        "font_family": "DM Sans, sans-serif",
        "weights": ["400", "500", "700"],
        "usage": "Chat text, UI labels, Settings"
      },
      "mono": {
        "font_family": "JetBrains Mono, monospace",
        "usage": "Timers, Codes, Usernames"
      }
    },
    "colors": {
      "palette": {
        "primary": {
          "name": "Cyber Lemon",
          "hex": "#F5E618",
          "tailwind": "bg-[#F5E618] text-black"
        },
        "secondary": {
          "name": "Hot Pink",
          "hex": "#EC4899",
          "tailwind": "bg-[#EC4899] text-white"
        },
        "accent": {
          "name": "Electric Purple",
          "hex": "#8B5CF6",
          "tailwind": "bg-[#8B5CF6] text-white"
        },
        "background": {
          "light": "#FAFAFA",
          "dark": "#0F172A"
        },
        "surface": {
          "light": "#FFFFFF",
          "dark": "#1E293B"
        }
      },
      "gradients": {
        "story_ring": "bg-gradient-to-tr from-[#F5E618] via-[#EC4899] to-[#8B5CF6]",
        "brand_mesh": "bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-yellow-200 via-pink-200 to-purple-200"
      }
    },
    "spacing": {
      "scale": "Generous",
      "container_padding": "p-6 md:p-8",
      "section_gap": "gap-8"
    },
    "radius": {
      "default": "rounded-2xl",
      "buttons": "rounded-full",
      "cards": "rounded-3xl"
    },
    "shadows": {
      "card": "shadow-[0_8px_30px_rgb(0,0,0,0.04)]",
      "button": "shadow-[0_4px_14px_0_rgba(0,0,0,0.1)] hover:shadow-[0_6px_20px_rgba(0,0,0,0.15)]",
      "pop": "shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
    }
  },
  "components": {
    "buttons": {
      "primary": "bg-[#F5E618] text-black font-bold rounded-full hover:scale-105 transition-transform shadow-sm",
      "secondary": "bg-white text-black border-2 border-black/5 font-bold rounded-full hover:bg-gray-50",
      "ghost": "hover:bg-black/5 text-black/80 rounded-full"
    },
    "cards": {
      "story": "aspect-[9/16] rounded-3xl overflow-hidden relative border-0 shadow-lg",
      "chat_row": "flex items-center gap-4 p-4 hover:bg-black/5 rounded-xl transition-colors cursor-pointer"
    },
    "inputs": {
      "default": "bg-gray-100 border-transparent focus:border-black focus:bg-white rounded-xl h-12 px-4 font-medium transition-all"
    },
    "navigation": {
      "bottom_bar": "fixed bottom-6 left-4 right-4 bg-black/90 backdrop-blur-xl text-white rounded-full h-16 flex items-center justify-around shadow-2xl z-50"
    }
  },
  "layout_strategies": {
    "mobile_first": true,
    "max_width": "max-w-md mx-auto md:max-w-lg",
    "containers": {
      "main": "min-h-screen bg-gray-50 pb-24 relative overflow-hidden",
      "camera_view": "fixed inset-0 bg-black z-40 flex flex-col"
    }
  },
